---
layout: layouts/index.njk
permalink: /
---

{#
  Renders a list of CV entries into one flowing paragraph.
  Each entry has `text` (may contain inline HTML) and an optional `datetime`,
  which is appended as a <time> element after a thin space, before the period.
  The visible year defaults to `datetime` with "/" swapped for an en dash
  (2011/2016 -> 2011–2016); set `label` on the entry to override it.
#}
{% macro cvEntries(entries) -%}
  {%- for entry in entries -%}
    {{ entry.text | safe }}
    {%- if entry.datetime -%}
      {%- set year = entry.label or (entry.datetime | replace("/", "–")) -%}
      &thinsp;<time datetime="{{ entry.datetime }}">{{ year }}</time>
    {%- endif -%}
    .{% if not loop.last %} {% endif %}
  {%- endfor -%}
{%- endmacro %}

<div class="content">
  <section class="intro">
    <div class="intro-color"></div>
    <p class="intro-about">Software designer and writer from California. I write about literature, design, art <em>&amp;</em> technology on my Substack newsletter, <a href="https://personalcanon.substack.com/">personal canon</a>.</p>
    <p class="intro-email">
      <a href="mailto:hello@celinenguyen.com">hello@celinenguyen.com</a>
    </p>
    <p class="intro-social">
      <a href="https://www.are.na/celine-nguyen">Are.na</a>
      <span class="intro-social-divider">✦</span>
      <a href="https://twitter.com/mynameisceline">Twitter</a>
      <span class="intro-social-divider">✦</span>
      <a href="http://instagram.com/doublepluslovely">Instagram</a>
      <span class="intro-social-divider">✦</span>
      <a href="https://www.goodreads.com/user/show/23270655-celine-nguyen" title="Goodreads">Goodreads</a>
    </p>
  </section>
  <section class="excited">
    <h2 class="excited-open">I'm very excited about</h2>
    <p class="excited-list">
      {% for e in excitedBy %}
        {% if loop.index is odd %}
          <span class="a">{{ e }}</span>
        {% else %}
          <span class="b">{{ e }}</span>
        {% endif %}
        {% if not loop.last %}
          <span class="divider">/</span>
        {% endif %}
      {% endfor %}
    </p>
    <h2 class="excited-close">so feel free to talk to me about these things!</h2>
  </section>
  <section class="cv">
    <section class="cv-right-now">
      <h2>This year</h2>
      <p>{{ cvEntries(thisYear) | safe }}</p>
    </section>
    <section class="cv-previously">
      <h2>Previously</h2>
      <p>{{ cvEntries(previously) | safe }}</p>
    </section>
  </section>
</div>
